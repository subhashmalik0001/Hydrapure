PORT=5050
NODE_ENV=development

# Supabase Credentials (Single Source of Truth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# SERVICE_ROLE_KEY is strictly server-side only. NEVER expose to frontend or mobile clients.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Secret (for offline/internal token verifications or device secrets)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long

# Device Auth Defaults
IOT_API_KEY=hp_iot_dev_key_jharkhand_2026
IOT_DEVICE_SECRET=hp_secret_mesh_991827410

# Security & CORS Whitelist (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,https://hydrapure.org

# Application URLs
FRONTEND_URL=http://localhost:3000
MOBILE_APP_URL=hydrapure://app

# Structured Logging
LOG_LEVEL=info
